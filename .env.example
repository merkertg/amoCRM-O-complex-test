# Скопируйте в .env и заполните. Файл .env не коммитится.

# ---------- LLM: любой OpenAI-совместимый API ----------
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1   (из Docker: http://host.docker.internal:11434/v1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Для моделей, которые не принимают temperature (например, reasoning-модели), укажите none
LLM_TEMPERATURE=0.2
# response_format=json_object. Выключите (false), если провайдер его не поддерживает
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=1200

# ---------- База знаний ----------
# KNOWLEDGE_BASE_PATH=data/knowledge_base.json
KB_TOP_K=5

# ---------- Приватность ----------
# Маскировать телефоны, e-mail и номера карт перед отправкой текста в LLM
REDACT_PII_FOR_LLM=true
LOG_LEVEL=INFO

# ---------- Доступ к интерфейсу менеджера ----------
# Логин и пароль HTTP Basic для интерфейса, /api/v1/suggest и /docs.
# Обязательно задайте на сервере, доступном не только с localhost.
# /health и /api/v1/amocrm/* защищены отдельно (JWT виджета, секрет вебхука).
UI_BASIC_AUTH_USERNAME=
UI_BASIC_AUTH_PASSWORD=
# Генераций в минуту на IP (интерфейс) или пользователя amoCRM (виджет); 0 — без лимита
RATE_LIMIT_PER_MINUTE=30

# ---------- amoCRM (необязательно) ----------
AMOCRM_ENABLED=false
# Адрес аккаунта
AMOCRM_BASE_URL=https://yoursubdomain.amocrm.ru
# Долгосрочный токен приватной интеграции (или access token OAuth 2.0)
AMOCRM_ACCESS_TOKEN=
# ID интеграции и секретный ключ — для проверки одноразовых токенов виджета
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
# Секрет в URL вебхука: https://<ваш-сервер>/api/v1/amocrm/webhook?secret=<значение>
AMOCRM_WEBHOOK_SECRET=
AMOCRM_HISTORY_LIMIT=20
AMOCRM_MESSAGE_TTL_HOURS=24
# Виджет обращается к серверу из браузера — разрешите домен аккаунта
CORS_ALLOW_ORIGINS=https://yoursubdomain.amocrm.ru
